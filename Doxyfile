# Doxyfile - Configuration Doxygen pour Borne Arcade IUT
# Générer la doc : doxygen Doxyfile

#---------------------------------------------------------------------------
# Projet
#---------------------------------------------------------------------------
PROJECT_NAME           = "Borne Arcade IUT"
PROJECT_BRIEF          = "Plateforme de borne d'arcade avec menu et collection de jeux"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/generated
OUTPUT_LANGUAGE        = French

#---------------------------------------------------------------------------
# Entrées
#---------------------------------------------------------------------------
INPUT                  = borne_arcade \
                         docs/pages
FILE_PATTERNS          = *.java \
                         *.py \
                         *.lua \
                         *.md
RECURSIVE              = YES
INPUT_ENCODING         = UTF-8

EXCLUDE                = borne_arcade/javazoom
EXCLUDE_PATTERNS       = */__pycache__/* \
                         */assets/* \
                         */fonts/* \
                         */img/* \
                         */sound/* \
                         */photos/* \
                         */rapport_soutenance/* \
                         */screenshots/* \
                         */maps/* \
                         */.git/*

#---------------------------------------------------------------------------
# Page principale
#---------------------------------------------------------------------------
USE_MDFILE_AS_MAINPAGE = docs/pages/mainpage.md

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
JAVADOC_AUTOBRIEF      = YES
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES

# Pas d'avertissement pour les éléments non documentés
# (la majorité du code n'a pas encore de commentaires doc)
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

#---------------------------------------------------------------------------
# Navigation dans le code source
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------------------
# Sortie HTML
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = AUTO_LIGHT
SEARCHENGINE           = YES

#---------------------------------------------------------------------------
# Sortie LaTeX / PDF (désactivée)
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Markdown
#---------------------------------------------------------------------------
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3

#---------------------------------------------------------------------------
# Diagrammes
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = NO
