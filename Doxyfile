# Doxyfile - Configuration Doxygen pour Borne Arcade IUT

# Projet
PROJECT_NAME           = "Borne Arcade IUT"
PROJECT_BRIEF          = "Menu et collection de jeux pour borne d'arcade Raspberry Pi"
PROJECT_NUMBER         = ""
OUTPUT_DIRECTORY       = docs/generated
OUTPUT_LANGUAGE        = French

# Entrees
INPUT                  = borne_arcade/ docs/pages/
RECURSIVE              = YES
FILE_PATTERNS          = *.java *.py *.lua *.md
EXCLUDE_PATTERNS       = */generated/* */__pycache__/* *.class */photos/* */rapport_soutenance/* */doc_minimale.md
USE_MDFILE_AS_MAINPAGE = docs/pages/mainpage.md

# Extraction
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_JAVA   = YES

# Source browsing
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# Sortie HTML
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = LIGHT
SEARCHENGINE           = YES

# Pas de LaTeX/RTF/XML
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

# Diagrammes
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES

# Avertissements
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_FORMAT            = "$file:$line: $text"

# Encodage
INPUT_ENCODING         = UTF-8
DOXYFILE_ENCODING      = UTF-8
